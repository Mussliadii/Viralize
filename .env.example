# Groq API — free tier, no credit card, get a key at https://console.groq.com/keys
GROQ_API_KEY=

# YouTube Data API v3 — enable in Google Cloud Console, create an API key
YOUTUBE_API_KEY=

# Pexels API — get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# SQLite (local dev) — no changes needed
DATABASE_URL="file:./dev.db"
